# ── EMA — Engineering Memory Agent — 环境变量模板 ────────────────────
# 复制此文件为 .env 并根据需要修改。
# cp .env.example .env
#
# 必备配置（至少需要 LLM + Database）：
#   LLM_API_KEY=sk-...          ← 你的 LLM API Key
#   DATABASE_URL=...            ← PostgreSQL 连接串（docker compose up -d 启动即可用默认值）

# =========================================================================
# LLM 配置
# =========================================================================
# 支持的 provider: deepseek (OpenAI 兼容), openai (OpenAI 兼容), anthropic
LLM_PROVIDER=deepseek

# API Key（必填）
LLM_API_KEY=sk-your-api-key-here

# API Base URL（DeepSeek 默认，OpenAI 兼容服务可替换）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称
#   DeepSeek: deepseek-v4-pro / deepseek-v4-flash
#   OpenAI:   gpt-4o / gpt-4o-mini
#   Anthropic: claude-fable-5 / claude-opus-5 / claude-sonnet-5 / claude-haiku-4-5-20251001
LLM_MODEL=deepseek-v4-pro

# 生成温度 (0.0-2.0)
LLM_TEMPERATURE=0.7

# 最大输出 token 数
LLM_MAX_TOKENS=4096

# 请求超时（秒）
LLM_TIMEOUT=60

# 结构化输出（实体/关系/冲突检测等 JSON 调用）最大重试次数
LLM_STRUCTURED_MAX_ATTEMPTS=3

# 结构化输出重试的基础退避间隔（秒，线性递增）
LLM_STRUCTURED_BACKOFF=0.5

# 结构化输出默认温度（实体/关系抽取、冲突检测等判定性场景）。
# 低温度保证输出稳定；单次调用可用 temperature= 覆盖
LLM_STRUCTURED_TEMPERATURE=0.1

# LLM rerank 并发上限：rerank_llm 对每个候选发一次 LLM 调用，
# 限制并发在途调用数，避免 20-40 个候选同时打爆 provider 限流
LLM_RERANK_CONCURRENCY=4

# Anthropic prompt caching：在 system 块和最后一个 tool schema 上加
# cache_control 断点，重复的 agent 轮次复用已缓存前缀。
# OpenAI/DeepSeek 等兼容 API 服务端自动缓存，无需此配置。
PROMPT_CACHING_ENABLED=true

# ── 传输层韧性：重试 + 熔断器（作用于 LLM/Embedding provider 调用）───────
# 对瞬时错误（429 / 5xx / 超时 / 连接错误）做指数退避重试
# 总尝试次数（含首次）：3 = 首次 + 2 次重试
LLM_RETRY_MAX_ATTEMPTS=3
# 退避初始间隔（秒，指数增长 + 抖动）
LLM_RETRY_BACKOFF_BASE=1.0
# 退避上限（秒）
LLM_RETRY_BACKOFF_MAX=8.0
# 熔断器：连续失败达到该次数后打开，冷却窗口内快速失败（不烧重试和 token）
LLM_CIRCUIT_BREAKER_THRESHOLD=5
# 熔断器冷却窗口（秒），冷却结束自动恢复探测
LLM_CIRCUIT_BREAKER_COOLDOWN=30.0

# ── LLM 故障转移（可选，默认关闭）──────────────────────────────────────
# 设置 LLM_FALLBACK_PROVIDER 后，主 provider 调用失败（重试耗尽的可重试
# 错误，或熔断器打开）时，该次调用会改走备用 provider。留空则关闭故障转移。
# 备用 provider 的其余 LLM_FALLBACK_* 字段在启用时必须配全。
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
# 备用 provider 为 OpenAI 兼容 API 时需要；anthropic 不需要
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_MAX_TOKENS=4096
LLM_FALLBACK_TIMEOUT=60

# ── LLM 评测 judge（可选，默认关闭）───────────────────────────────────
# LLM 行为评测（tests/eval.run_llm_eval）的 LLM-as-judge 专用 provider。
# 留空则 judge 回退主 provider（自评，行为不变）。要开启 judge 必须同时填
# 全 PROVIDER / MODEL / API_KEY / BASE_URL 四个字段（anthropic 不需要
# BASE_URL），缺任一字段评测会拒绝以 --judge llm 启动。
# 参考（GLM-4.7-Flash 为免费模型，走智谱 OpenAI 兼容端点）：
LLM_JUDGE_PROVIDER=
LLM_JUDGE_API_KEY=
LLM_JUDGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_JUDGE_MODEL=glm-4.7-flash

# ── LLM usage tracing（观测）──────────────────────────────────────────
# 每次 LLM 调用记录一行观测并落 llm_usage 表（内存缓冲 + 后台批量 flush），
# 查询 API：/api/usage/summary | /scenarios | /models | /threads/{id} | /trace/{id}
USAGE_ENABLED=true
# flusher 落库间隔（秒）
USAGE_FLUSH_INTERVAL_SECONDS=10
# 内存缓冲上限，溢出丢最旧（观测绝不阻塞 LLM 热路径）
USAGE_BUFFER_MAX=5000
# 成功调用的 prompt/response 采样存储比例（0~1，供事后质量分析：
# /api/usage/samples）。error 调用无论此值一律采样。设 0 关闭成功路径采样。
USAGE_SAMPLE_RATE=0.05
# 采样文本保留天数：到期后由 usage flusher 清空 prompt_sample/response_sample
# 列（元数据行保留，供用量汇总），防止采样文本无限累积。
USAGE_SAMPLE_RETENTION_DAYS=30

# ── 运行健康指标（Prometheus）──────────────────────────────────────────
# 开启后 GET /metrics 暴露进程内时序：HTTP 请求/延迟分位数、LLM 调用/token、
# 熔断器状态、Agent 并发槽位、ReAct 步数分布。与 USAGE_ENABLED 独立（这是
# 进程本地健康观测，llm_usage 是持久化成本行）。关闭则 /metrics 返回 404。
METRICS_ENABLED=true

# ── 结构化日志（集中化采集）────────────────────────────────────────────
# 日志走 stdout（docker compose logs）。LOG_FORMAT=json 时每行输出单行 JSON
# （ts 为 UTC ISO-8601，含 trace_id / thread_id，可被 Loki/ELK 直接摄取），
# 默认 text 保持人类可读。见 deployment.md Logging。
LOG_FORMAT=text

# ── API 限流（per-key 令牌桶）──────────────────────────────────────────
# 按 API key 限制请求速率，防止无限调用烧 LLM token（单轮对话实测约 28.6k
# tokens）。两档：chat 档（/api/agent/chat*、/api/scenarios*，LLM 密集）更严格，
# general 档（其余 /api 路由）宽松。桶为进程内状态（单实例部署假设，见
# deployment.md 单实例部署约束）；超限请求返回 429 + Retry-After 头。
RATE_LIMIT_ENABLED=true
# chat 档：窗口内允许请求数 / 窗口秒数
RATE_LIMIT_CHAT_REQUESTS=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
# general 档：窗口内允许请求数 / 窗口秒数
RATE_LIMIT_GENERAL_REQUESTS=120
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60

# =========================================================================
# 备份与监控（docker compose 服务）
# =========================================================================
# 数据库备份：compose 的 backup 容器每小时 pg_dump -Fc 全库到 ./backups/
# （挂载宿主目录，已在 .gitignore）。恢复流程见 docs/deployment.md。
# 以下为备份容器的默认值，在 .env 覆盖后 `docker compose up -d backup` 生效
# （compose 从本文件插值，见 docker-compose.yml）。
BACKUP_INTERVAL=3600
# 保留最近多少份备份（滚动删除更旧的）
BACKUP_KEEP=14
# Grafana 管理员初始密码（compose 中默认 admin，首次登录后请修改）
GF_ADMIN_PASSWORD=admin
# HTTPS/TLS 反向代理（compose 的 caddy 服务，见 deployment.md HTTPS (TLS)）
# 默认 http://localhost:8080 纯 HTTP 本地测试；公网部署设为你的域名
# （如 https://ema.example.com），Caddy 自动申请 Let's Encrypt 证书并托管
# 443/80。注意：设域名后走 443 端口。
CADDY_SITE_ADDRESS=http://localhost:8080
# Let's Encrypt 证书到期通知邮箱（可选，仅公网部署需要）。由 Caddyfile 的
# 全局 `email` 选项消费；留空则 Caddy 用匿名默认账号。
ACME_EMAIL=

# =========================================================================
# Embedding 配置
# =========================================================================

# ── 方案 A：本地 BGE-M3（默认，零 API 成本）────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# 切换 embedding 模型（维度变化）后：重启时 init_db 会把向量列自动迁移到新维度
# （迁移会清空已有向量），随后运行 `python reembed_embeddings.py` 从存储文本分批重嵌。
EMBEDDING_BATCH_SIZE=32
# Embedding API 请求超时（秒；仅 OpenAI/兼容 provider 生效，本地 BGE 不走 HTTP）
EMBEDDING_TIMEOUT=60
EMBEDDING_NORMALIZE=true
# HuggingFace 镜像（国内加速用）
EMBEDDING_HF_ENDPOINT=https://hf-mirror.com
# CPU 并发控制（本地 BGE）：EMBEDDING_MAX_CONCURRENCY 限制同时进行的推理
# 任务数，EMBEDDING_TORCH_THREADS 限制单任务的内部线程数——两者乘积≈核数时
# 零超卖，消除并发延迟长尾（冷路径压测 10 并发 P95 19s→690ms）。高并发场景
# 可上调 MAX_CONCURRENCY 换吞吐（P95 会回升），详见 docs/deployment.md。
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_TORCH_THREADS=4

# ── 方案 B：OpenAI Embedding（取消注释以下 5 行并注释掉方案 A）─────────
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-your-api-key-here
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BATCH_SIZE=100

# ── 可选：跨 provider 故障转移 ─────────────────────────────────────────
# 主 provider 失败（重试耗尽、熔断打开、或本地模型损坏）后，调用改走备用
# provider 一次。默认关闭。注意：备用模型维度必须与主模型一致（等于 pgvector
# schema 维度），否则 failover 写入会被数据库拒绝。EMBEDDING_FALLBACK_MODEL
# 必填；openai 备用还需 EMBEDDING_FALLBACK_API_KEY。
# EMBEDDING_FALLBACK_PROVIDER=openai
# EMBEDDING_FALLBACK_API_KEY=sk-your-api-key-here
# EMBEDDING_FALLBACK_BASE_URL=https://api.openai.com/v1
# EMBEDDING_FALLBACK_MODEL=text-embedding-3-small
# EMBEDDING_FALLBACK_BATCH_SIZE=32
# EMBEDDING_FALLBACK_TIMEOUT=60

# =========================================================================
# Webhook 配置
# =========================================================================
# 各连接器的 webhook secret。不设置则对应连接器在前端显示为 "pending"。
# 外部系统发送 webhook 时需在 header 中携带 HMAC-SHA256 签名：
#   X-Webhook-Signature: sha256=<hex>
# 或
#   X-Hub-Signature-256: sha256=<hex>
#
# PingCode webhook secret
WEBHOOK_PINGCODE_SECRET=
# PingCode 实例的 base URL（用于生成可溯源的工作项链接）
WEBHOOK_PINGCODE_BASE_URL=https://your-org.pingcode.com
#
# CI webhook secret（Jenkins / GitHub Actions / GitLab CI 通用）
WEBHOOK_CI_SECRET=
#
# 飞书 webhook secret
WEBHOOK_FEISHU_SECRET=
# 飞书租户域名前缀（用于生成消息链接）
WEBHOOK_FEISHU_TENANT=your-tenant

# =========================================================================
# 数据库配置
# =========================================================================
# PostgreSQL + pgvector（docker compose up -d 启动）。
# - 本地直接运行（非 compose，uvicorn）用 localhost 连接串，或留空走 config 默认值。
# - docker compose 部署时：不设置则用 docker-compose.yml 的默认值
#   （postgresql://ema:<pass>@postgres:5432/ema_dev，指向 compose 网络内 postgres 服务）。
#   若需覆盖（如恢复后切到新库、改口令），在 .env 设置完整连接串 —— 注意 compose
#   容器内 localhost 是容器自己，必须用 postgres 服务名。改口令同时改 POSTGRES_PASSWORD。
# DATABASE_URL=postgresql://ema:ema123@localhost:5432/ema_dev

# 数据库口令（compose 部署时 postgres 容器与 backup 容器的单一来源，默认 ema123）。
# 生产环境请务必修改。注意：若同时设置了上面的 DATABASE_URL，其中内嵌的口令也要同步。
POSTGRES_PASSWORD=ema123

# =========================================================================
# Agent 配置
# =========================================================================
# ReAct 循环最大工具调用次数
MAX_AGENT_STEPS=5

# Git 仓库摄取沙箱（REPO_ALLOW_ROOT）：逗号分隔的允许根目录列表，
# ingest_git_repo_tool 只能读取这些目录下的本地 Git 仓库。留空（默认）=
# 完全禁用 git 摄取（fail-closed，所有 ingest 都会被拒绝并提示配置）。
# 这是防止注入指令/误导的 Agent 读取服务器任意本地仓库的护栏。
# 示例：REPO_ALLOW_ROOT=/srv/git,/home/deploy/repos
#REPO_ALLOW_ROOT=

# Agent 单回合总超时（秒）：一次请求到最终回复的总时间预算，
# 超过即中止本轮并返回超时错误（防止慢 provider/多工具步骤把请求挂数分钟）
AGENT_TIMEOUT=180

# 同时运行的交互式 Agent 会话上限。每个会话在整个 ReAct 循环期间占用 LLM
# 额度（最长 AGENT_TIMEOUT），无上限的并发会话会一起打满 provider 限流并
# 触发熔断。超过上限的 chat 请求返回 503（拒绝而非排队）。
MAX_AGENT_CONCURRENCY=4

# =========================================================================
# 巡检配置
# =========================================================================
# 是否启用巡检调度器（false 时完全关闭后台巡逻）
PATROL_ENABLED=true

# 每日巡检触发时间（0-23，默认早 8:00）
PATROL_DAILY_HOUR=8

# 是否启用每周深度巡检
PATROL_WEEKLY_ENABLED=true

# 每周巡检触发日期和时间（0=周一, 6=周日，默认周一早 9:00）
PATROL_WEEKLY_DAY=1
PATROL_WEEKLY_HOUR=9

# 单次巡检总超时（秒）：后台巡检扫描全量记忆，比交互式 AGENT_TIMEOUT 更长，
# 超时即标记该次巡检为 failed（防止卡死永久 running）
PATROL_TIMEOUT=600

# 巡检最终报告合成的输出上限（token）：独立于交互式 LLM_MAX_TOKENS。
# 报告在单次 LLM 调用内生成、必须输出完整的 JSON；模型把部分额度花在内部
# 推理后，4096 的交互上限会把报告截断导致巡检校验失败。daily/weekly prompt
# 限制各类条目数，让报告体积在提高后的上限内放得下。
PATROL_MAX_TOKENS=8000

# =========================================================================
# 飞书通知
# =========================================================================
# 飞书机器人 Webhook URL（不设置则不推送飞书通知）
# 在飞书群聊中添加自定义机器人，复制其 Webhook 地址填入即可
FEISHU_WEBHOOK_URL=

# =========================================================================
# Memory 配置
# =========================================================================
# 是否启用记忆系统（开发时可关闭以跳过 embedding 模型加载）
MEMORY_ENABLED=true

# 自动记忆：用户提供有实质内容的知识时，自动写入记忆库
# （除非本轮已通过 write_memory_tool 显式写入）。默认开启；
# 设 false 恢复为仅按用户显式请求写入。
# 每次捕获消耗 3 次 LLM 抽取 + embedding + 相似度检索，因此按线程
# 限制最小写入间隔（秒）。质量判断统一由一次轻量 LLM 二分类完成
# （长度预筛后判断"这段是否值得长期记忆"，再进入提取）。
AUTO_MEMORY_ENABLED=true
AUTO_MEMORY_MIN_INTERVAL=60

# 对话压缩：超窗的早期消息折叠为一条 running-summary 摘要，而非硬截断。
# 默认开启；设 false 恢复为旧有的窗口截断行为。
CONVERSATION_COMPACTION_ENABLED=true

# Agent 上下文窗口的 token 预算：每轮发送给 LLM 的历史+工具结果的目标上限。
# 窗口按此预算（CJK 感知的粗略估算）保留最近的对话，长消息收窄窗口、短消息放宽。
CONTEXT_TOKEN_BUDGET=12000

# =========================================================================
# 应用配置
# =========================================================================
# 运行环境: development | test | production
APP_ENV=development

# API 认证：所有 /api/* 路由都要求请求头携带
#   Authorization: Bearer <EMA_API_KEY>
# 未设置时 API 请求一律 401（APP_ENV=test 例外，测试依赖 mock 放行）。
# 前端通过 VITE_EMA_API_KEY（见下）在请求中带上同一个 key。
EMA_API_KEY=your-api-key-here

# 前端注入的 API key（构建期替换 import.meta.env.VITE_EMA_API_KEY）。
# 与 EMA_API_KEY 保持一致。未配置时前端请求不携带认证头（向后兼容）。
VITE_EMA_API_KEY=your-api-key-here

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
