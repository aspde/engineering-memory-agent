# ── EMA — Engineering Memory Agent — 环境变量模板 ────────────────────
# 复制此文件为 .env 并根据需要修改。
# cp .env.example .env
#
# 必备配置（至少需要 LLM + Database）：
#   LLM_API_KEY=sk-...          ← 你的 LLM API Key
#   DATABASE_URL=...            ← PostgreSQL 连接串（docker compose up -d 启动即可用默认值）
#
# 本文件前半部分为直接生效的常用配置；后半部分为默认关闭的可选配置
# （故障转移、webhook/连接器、垂直场景、巡检、compose 附加服务），
# 需要时取消注释并按注释填写。
# 更细的调优参数——LLM 重试/熔断、结构化输出重试、rerank 并发、usage 缓冲/
# flush、限流配额、embedding 并发等——在 backend/shared/config.py 中带默认值，
# 仍可用同名环境变量覆盖，只是不在此展示。

# =========================================================================
# 1. LLM 配置
# =========================================================================
# 支持的 provider: deepseek (OpenAI 兼容), openai (OpenAI 兼容), anthropic
LLM_PROVIDER=deepseek

# API Key（必填）
LLM_API_KEY=sk-your-api-key-here

# API Base URL（DeepSeek 默认，OpenAI 兼容服务可替换）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称
#   DeepSeek: deepseek-v4-pro / deepseek-v4-flash
#   OpenAI:   gpt-4o / gpt-4o-mini
#   Anthropic: claude-fable-5 / claude-opus-5 / claude-sonnet-5 / claude-haiku-4-5-20251001
LLM_MODEL=deepseek-v4-pro

# 生成温度 (0.0-2.0)
LLM_TEMPERATURE=0.7

# 最大输出 token 数
LLM_MAX_TOKENS=4096

# 请求超时（秒）
LLM_TIMEOUT=60

# Anthropic prompt caching：在 system 块和最后一个 tool schema 上加
# cache_control 断点，重复的 agent 轮次复用已缓存前缀。
# OpenAI/DeepSeek 等兼容 API 服务端自动缓存，无需此配置。
PROMPT_CACHING_ENABLED=true

# 结构化输出（实体/关系抽取、冲突检测等判定性场景）使用低默认温度保证稳定，
# 其重试次数/退避/默认温度可分别用 LLM_STRUCTURED_MAX_ATTEMPTS /
# LLM_STRUCTURED_BACKOFF / LLM_STRUCTURED_TEMPERATURE 覆盖（默认见 config.py）。
# LLM rerank 并发上限同理，用 LLM_RERANK_CONCURRENCY 覆盖。

# 传输层韧性（重试 + 熔断器）：对瞬时错误（429 / 5xx / 超时 / 连接错误）做
# 指数退避重试，并带熔断器防止连续失败烧 token。默认值在 config.py 的
# ResilienceConfig，可覆盖：
#   LLM_RETRY_MAX_ATTEMPTS=3  总尝试次数（含首次）
#   LLM_RETRY_BACKOFF_BASE=1.0 / LLM_RETRY_BACKOFF_MAX=8.0  退避初始/上限（秒）
#   LLM_CIRCUIT_BREAKER_THRESHOLD=5 / LLM_CIRCUIT_BREAKER_COOLDOWN=30.0
# 连续失败达到阈值后打开熔断器，冷却窗口内快速失败（不烧重试和 token）。

# =========================================================================
# 2. 观测：用量追踪 / 健康指标 / 日志 / 限流
# =========================================================================
# LLM usage tracing：每次 LLM 调用记录一行观测并落 llm_usage 表
# （内存缓冲 + 后台批量 flush）。查询 API：/api/usage/summary | /scenarios |
# /models | /threads/{id} | /trace/{id}。缓冲上限、flush 间隔、采样率与
# 采样保留天数用 USAGE_FLUSH_INTERVAL_SECONDS / USAGE_BUFFER_MAX /
# USAGE_SAMPLE_RATE / USAGE_SAMPLE_RETENTION_DAYS 覆盖（默认见 config.py）。
USAGE_ENABLED=true

# 运行健康指标（Prometheus）：开启后 GET /metrics 暴露进程内时序（HTTP 请求/
# 延迟分位数、LLM 调用/token、熔断器状态、Agent 并发槽位、ReAct 步数分布）。
# 与 USAGE_ENABLED 独立（这是进程本地健康观测，llm_usage 是持久化成本行）。
METRICS_ENABLED=true

# 结构化日志（集中化采集）：日志走 stdout（docker compose logs）。
# LOG_FORMAT=json 时每行输出单行 JSON（ts 为 UTC ISO-8601，含 trace_id /
# thread_id，可被 Loki/ELK 直接摄取），默认 text 保持人类可读。
LOG_FORMAT=text

# API 限流（per-key 令牌桶）：按 API key 限制请求速率，防止无限调用烧 LLM
# token（单轮对话实测约 28.6k tokens）。两档：chat 档（/api/agent/chat*、
# /api/scenarios*，LLM 密集）更严格，general 档（其余 /api 路由）宽松。
# 超限请求返回 429 + Retry-After 头。配额用 RATE_LIMIT_CHAT_REQUESTS /
# RATE_LIMIT_CHAT_WINDOW_SECONDS / RATE_LIMIT_GENERAL_REQUESTS /
# RATE_LIMIT_GENERAL_WINDOW_SECONDS 覆盖（默认 30/60 与 120/60，见 config.py）。
RATE_LIMIT_ENABLED=true

# =========================================================================
# 3. Embedding 配置
# =========================================================================

# ── 方案 A：本地 BGE-M3（默认，零 API 成本）────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# 切换 embedding 模型（维度变化）后：重启时 init_db 会把向量列自动迁移到新维度
# （迁移会清空已有向量），随后运行 `python reembed_embeddings.py` 从存储文本分批重嵌。
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
# HuggingFace 镜像（国内加速用）
EMBEDDING_HF_ENDPOINT=https://hf-mirror.com
# 本地 BGE 的 CPU 并发控制（EMBEDDING_MAX_CONCURRENCY 限制同时推理任务数，
# EMBEDDING_TORCH_THREADS 限制单任务内部线程数，两者乘积≈核数时零超卖）与
# OpenAI/兼容端的请求超时（EMBEDDING_TIMEOUT）用同名变量覆盖，默认见 config.py。

# =========================================================================
# 4. 数据库配置
# =========================================================================
# PostgreSQL + pgvector（docker compose up -d 启动）。
#
# ── 密码与连接布局（四环境一图看懂）────────────────────────────
# 占位密码 ema123 是代码库唯一默认：backend/shared/config.py 的 DATABASE_URL
# 默认、docker-compose.yml 的 ${...:-ema123} 回退、ci.yml / eval.yml 的服务
# 密码、tests/conftest.py 的回退，全部一致。真实凭据只存在于本机 gitignored
# 的 .env（不在版本库）。各环境的连接路径：
#
#   本地开发  → .env 的 DATABASE_URL（@postgres 连 compose 的 postgres 容器；
#               或 @localhost:5432 直接连本机 PG / compose 映射端口）
#   本地测试  → tests/conftest.py 从 .env 的 DATABASE_URL 推导 user:password，
#               固定连 127.0.0.1:5432 的 ema_test 库（本机独立 PG 的 ema
#               密码必须与 .env 一致，否则用 TEST_DATABASE_URL 显式覆盖）
#   docker    → postgres 容器用 ${POSTGRES_PASSWORD:-ema123} 初始化；
#               backend 容器用 .env 的 DATABASE_URL（@postgres 服务名）
#   CI        → 无 .env，全部走 ema123 默认（config 默认 ema123@localhost
#               + 服务密码 ema123，天然匹配）
#
# 注意：POSTGRES_PASSWORD 只在 postgres 数据卷首次初始化时生效——已用某密码
# 初始化的卷，改密码后必须重建卷（docker compose down -v）才切换，否则后端
# 连接仍用旧密码。生产部署改默认密码后，DATABASE_URL 内嵌口令要同步。
# ───────────────────────────────────────────────────────────────────
#
# - 本地直接运行（非 compose，uvicorn）用 localhost 连接串，或留空走 config 默认值。
# - docker compose 部署时：不设置则用 docker-compose.yml 的默认值
#   （postgresql://ema:<pass>@postgres:5432/ema_dev，指向 compose 网络内 postgres 服务）。
#   若需覆盖（如恢复后切到新库、改口令），在 .env 设置完整连接串 —— 注意 compose
#   容器内 localhost 是容器自己，必须用 postgres 服务名。改口令同时改 POSTGRES_PASSWORD。
# DATABASE_URL=postgresql://ema:ema123@localhost:5432/ema_dev

# 测试数据库连接串（可选）。pytest 的 bootstrap（tests/conftest.py）按以下
# 优先级取测试库 URL，保证本机/CI 不靠硬编码密码就能连：
#   1. TEST_DATABASE_URL 显式设置（最高优先，CI 可在此显式传与 service 一致的凭据）
#   2. 无显式设置时，从本 .env 的 DATABASE_URL 推导 user:password，
#      固定连 127.0.0.1:5432 的 ema_test 库（仅凭据取自 .env，主机/库名固定）
#   3. 两者都没有（全新 clone / 无 .env 的 CI）时回退占位 ema123
# 本机只需保持 .env 的 DATABASE_URL 为真实值，直接跑 pytest 即可，无需额外设置。
# TEST_DATABASE_URL=postgresql://ema:ema123@127.0.0.1:5432/ema_test

# 数据库口令（compose 部署时 postgres 容器与 backup 容器的单一来源，默认 ema123）。
# 生产环境请务必修改。注意：若同时设置了上面的 DATABASE_URL，其中内嵌的口令也要同步。
POSTGRES_PASSWORD=ema123

# =========================================================================
# 5. Agent 配置
# =========================================================================
# ReAct 循环最大工具调用次数
MAX_AGENT_STEPS=5

# Git 仓库摄取沙箱（REPO_ALLOW_ROOT）：逗号分隔的允许根目录列表，
# ingest_git_repo_tool 只能读取这些目录下的本地 Git 仓库。留空（默认）=
# 完全禁用 git 摄取（fail-closed，所有 ingest 都会被拒绝并提示配置）。
# 这是防止注入指令/误导的 Agent 读取服务器任意本地仓库的护栏。
# 示例：REPO_ALLOW_ROOT=/srv/git,/home/deploy/repos
#REPO_ALLOW_ROOT=

# Agent 单回合总超时（秒）：一次请求到最终回复的总时间预算，
# 超过即中止本轮并返回超时错误（防止慢 provider/多工具步骤把请求挂数分钟）
AGENT_TIMEOUT=180

# 同时运行的交互式 Agent 会话上限。每个会话在整个 ReAct 循环期间占用 LLM
# 额度（最长 AGENT_TIMEOUT），无上限的并发会话会一起打满 provider 限流并
# 触发熔断。超过上限的 chat 请求返回 503（拒绝而非排队）。
MAX_AGENT_CONCURRENCY=4

# =========================================================================
# 6. Memory 配置
# =========================================================================
# 是否启用记忆系统（开发时可关闭以跳过 embedding 模型加载）
MEMORY_ENABLED=true

# 自动记忆：用户提供有实质内容的知识时，自动写入记忆库
# （除非本轮已通过 write_memory_tool 显式写入）。默认开启；
# 设 false 恢复为仅按用户显式请求写入。
# 每次捕获消耗 3 次 LLM 抽取 + embedding + 相似度检索，因此按线程
# 限制最小写入间隔（秒）。质量判断统一由一次轻量 LLM 二分类完成
# （长度预筛后判断"这段是否值得长期记忆"，再进入提取）。
AUTO_MEMORY_ENABLED=true
AUTO_MEMORY_MIN_INTERVAL=60

# 对话压缩：超窗的早期消息折叠为一条 running-summary 摘要，而非硬截断。
# 默认开启；设 false 恢复为旧有的窗口截断行为。
CONVERSATION_COMPACTION_ENABLED=true

# Agent 上下文窗口的 token 预算：每轮发送给 LLM 的历史+工具结果的目标上限。
# 窗口按此预算（CJK 感知的粗略估算）保留最近的对话，长消息收窄窗口、短消息放宽。
CONTEXT_TOKEN_BUDGET=12000

# =========================================================================
# 7. 飞书通知
# =========================================================================
# 飞书机器人 Webhook URL（不设置则不推送飞书通知）
# 在飞书群聊中添加自定义机器人，复制其 Webhook 地址填入即可
FEISHU_WEBHOOK_URL=

# =========================================================================
# 8. 应用配置
# =========================================================================
# 运行环境: development | test | production
APP_ENV=development

# API 认证：所有 /api/* 路由要求请求头携带
#   Authorization: Bearer <key>
# key 为以下两者之一：EMA_API_KEY（服务端 / 管理员）或 VITE_EMA_API_KEY（前端）。
# 未设置 EMA_API_KEY 时 API 请求一律 401（APP_ENV=test 例外，测试依赖 mock 放行）。
EMA_API_KEY=your-api-key-here

# 前端专用 key（构建期替换 import.meta.env.VITE_EMA_API_KEY 打进 JS bundle）。
# 刻意与 EMA_API_KEY 不同：bundle 中的 key 任何访问前端页面的人都能提取，
# 拆分后它不再是管理员凭据。改动后需重新构建前端镜像。
# 未配置时前端请求不携带认证头（向后兼容）。
VITE_EMA_API_KEY=your-api-key-here

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# =========================================================================
# 以下为默认关闭的可选配置（取消注释后生效）─────────────────────────────
# =========================================================================

# ── LLM 故障转移（多 provider 容灾，默认关闭）──────────────────────────
# 设置 LLM_FALLBACK_PROVIDER 后，主 provider 调用失败（重试耗尽的可重试
# 错误，或熔断器打开）时，该次调用会改走备用 provider。留空则关闭故障转移。
# 启用时必须配全其余字段（base_url 仅 OpenAI 兼容 provider 需要）。
# LLM_FALLBACK_PROVIDER=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_MAX_TOKENS=4096
# LLM_FALLBACK_TIMEOUT=60

# ── LLM 评测 judge（跑行为评测时启用，默认关闭）────────────────────────
# LLM 行为评测（tests/eval.run_llm_eval）的 LLM-as-judge 专用 provider，
# 避免同模型自评偏差。留空则 judge 回退主 provider。启用时必须配全
# PROVIDER / MODEL / API_KEY / BASE_URL（anthropic 不需要 BASE_URL）。
# 参考（GLM-4.7-Flash 为免费模型，走智谱 OpenAI 兼容端点）：
# LLM_JUDGE_PROVIDER=
# LLM_JUDGE_API_KEY=
# LLM_JUDGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_JUDGE_MODEL=glm-4.7-flash

# ── Embedding：方案 B（OpenAI API）──────────────────────────────────────
# 取消注释以下 5 行并注释掉第 3 节的方案 A。
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-your-api-key-here
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BATCH_SIZE=100

# ── Embedding：跨 provider 故障转移（默认关闭）──────────────────────────
# 主 provider 失败（重试耗尽、熔断打开、或本地模型损坏）后，调用改走备用
# provider 一次。注意：备用模型维度必须与主模型一致（等于 pgvector
# schema 维度），否则 failover 写入会被数据库拒绝。EMBEDDING_FALLBACK_MODEL
# 必填；openai 备用还需 EMBEDDING_FALLBACK_API_KEY。
# EMBEDDING_FALLBACK_PROVIDER=openai
# EMBEDDING_FALLBACK_API_KEY=sk-your-api-key-here
# EMBEDDING_FALLBACK_BASE_URL=https://api.openai.com/v1
# EMBEDDING_FALLBACK_MODEL=text-embedding-3-small
# EMBEDDING_FALLBACK_BATCH_SIZE=32
# EMBEDDING_FALLBACK_TIMEOUT=60

# ── Webhook / 连接器（默认关闭，ADR-011）────────────────────────────────
# 连接器 / webhook 模块的总开关。false 时 webhook 与 connector 路由不挂载
# （404）、连接器不注册。有真实数据源时置 true 并配置对应 secret。
# 外部系统发送 webhook 时需在 header 中携带 HMAC-SHA256 签名：
#   X-Webhook-Signature: sha256=<hex>
# 或
#   X-Hub-Signature-256: sha256=<hex>
# CONNECTORS_ENABLED=false
# # PingCode webhook secret 与实例 base URL（生成可溯源的工作项链接）
# WEBHOOK_PINGCODE_SECRET=
# WEBHOOK_PINGCODE_BASE_URL=https://your-org.pingcode.com
# # CI webhook secret（Jenkins / GitHub Actions / GitLab CI 通用）
# WEBHOOK_CI_SECRET=
# # 飞书 webhook secret 与租户域名前缀（生成消息链接）
# WEBHOOK_FEISHU_SECRET=
# WEBHOOK_FEISHU_TENANT=your-tenant

# ── 垂直场景（默认关闭，ADR-011）────────────────────────────────────────
# 复盘 / 代码审查 / Onboarding / 技术债。总开关 false 时 /api/scenarios*
# 路由不挂载（404）。场景有真实输入后置 true。
# SCENARIOS_ENABLED=false
# # 单场景运行超时（秒）：场景是完整 compose 链（agent ReAct + 格式化），
# # 比交互 AGENT_TIMEOUT 更长；超时该场景返回 504。
# SCENARIO_TIMEOUT_SECONDS=300
# # 并发场景上限：每个场景占用 agent/LLM 槽位，超限返回 503（拒绝而非排队）。
# MAX_SCENARIO_CONCURRENCY=2

# ── 巡检（默认关闭，ADR-011）────────────────────────────────────────────
# 生产库为空时巡检只会空跑烧 LLM 调用；记忆库有真实内容后置 true。
# PATROL_ENABLED=false
# # 每日巡检触发时间（0-23，默认早 8:00）
# PATROL_DAILY_HOUR=8
# # 是否启用每周深度巡检
# PATROL_WEEKLY_ENABLED=true
# # 每周巡检触发日期和时间（0=周一, 6=周日，默认周一早 9:00）
# PATROL_WEEKLY_DAY=1
# PATROL_WEEKLY_HOUR=9
# # 单次巡检总超时（秒）：后台巡检扫描全量记忆，比交互式 AGENT_TIMEOUT 更长，
# # 超时即标记该次巡检为 failed（防止卡死永久 running）
# PATROL_TIMEOUT=600
# # 巡检最终报告合成的输出上限（token）：报告在单次 LLM 调用内生成并必须输出
# # 完整 JSON，独立于交互式 LLM_MAX_TOKENS（4096 交互上限会把报告截断导致
# # 巡检校验失败；daily/weekly prompt 限制各类条目数让报告放得下）。
# PATROL_MAX_TOKENS=8000

# ── 仅供 docker compose 使用（observability 附加服务）───────────────────
# 以下变量由 docker-compose.yml 插值，默认值即可，按需覆盖：
#   docker compose --profile observability up -d backup / prometheus / grafana
# # 宿主 HuggingFace 模型缓存目录（backend 容器挂载到
# # /home/ema/.cache/huggingface；不设则用 ./docker/models）。指向已存在的
# # ~/.cache/huggingface 可复用已下载的模型、免再拷贝。
# HF_CACHE_DIR=C:/Users/yourname/.cache/huggingface
# # 数据库备份：backup 容器每小时 pg_dump -Fc 全库到 ./backups/
# # （挂载宿主目录，已在 .gitignore）。恢复流程见 docs/deployment.md。
# BACKUP_INTERVAL=3600
# # 保留最近多少份备份（滚动删除更旧的）
# BACKUP_KEEP=14
# # Grafana 管理员初始密码（默认 admin，首次登录后请修改）
# GF_ADMIN_PASSWORD=admin
# # HTTPS/TLS 反向代理（compose 的 caddy 服务，见 deployment.md HTTPS (TLS)）。
# # 默认 http://localhost:8080 纯 HTTP 本地测试；公网部署设为你的域名
# # （如 https://ema.example.com），Caddy 自动申请 Let's Encrypt 证书并托管
# # 443/80。注意：设域名后走 443 端口。
# CADDY_SITE_ADDRESS=http://localhost:8080
# # Let's Encrypt 证书到期通知邮箱（可选，仅公网部署需要）。由 Caddyfile 的
# # 全局 `email` 选项消费；留空则 Caddy 用匿名默认账号。
# ACME_EMAIL=
